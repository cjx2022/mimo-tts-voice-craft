<Window x:Class="MimoTtsVoiceCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helper="clr-namespace:MimoTtsVoiceCraft.Helpers"
        Title="MiMo TTS Voice Craft" Width="1180" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F3F7FD" FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <helper:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <!-- 模型选择分段按钮 -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowGradient}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

        <!-- 柔和炫彩层：铺满整窗的大半径径向渐变（无色块边界），叠加在整体渐变之上 -->
        <Rectangle Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush MappingMode="RelativeToBoundingBox"
                                     Center="0.16,0.10" GradientOrigin="0.16,0.10" RadiusX="1.25" RadiusY="1.25">
                    <GradientStop Color="#59B7D7FF" Offset="0"/>
                    <GradientStop Color="#2BB7D7FF" Offset="0.45"/>
                    <GradientStop Color="#00B7D7FF" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush MappingMode="RelativeToBoundingBox"
                                     Center="0.94,0.96" GradientOrigin="0.94,0.96" RadiusX="1.35" RadiusY="1.35">
                    <GradientStop Color="#42F2B4D6" Offset="0"/>
                    <GradientStop Color="#24F2B4D6" Offset="0.48"/>
                    <GradientStop Color="#00F2B4D6" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush MappingMode="RelativeToBoundingBox"
                                     Center="0.52,1.14" GradientOrigin="0.52,1.14" RadiusX="1.45" RadiusY="1.45">
                    <GradientStop Color="#2ECDBAFF" Offset="0"/>
                    <GradientStop Color="#10CDBAFF" Offset="0.55"/>
                    <GradientStop Color="#00CDB8FF" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

            <!-- ============ 标题栏 ============ -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="22" Height="22" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MiMo TTS Voice Craft" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="TitleHint" Text="v0.8.1 · 非官方客户端" Margin="12,2,0,0"
                               VerticalAlignment="Center" Style="{DynamicResource Hint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAbout" Style="{DynamicResource CaptionButton}" Click="BtnAbout_Click"
                            ToolTip="关于 / 版权申明">
                        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource SubTextBrush}"
                              Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
                    </Button>
                    <Button x:Name="BtnSettings" Style="{DynamicResource CaptionButton}" Click="BtnSettings_Click"
                            ToolTip="设置 API Key / 输出目录">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SubTextBrush}"
                              VerticalAlignment="Center"
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                    </Button>
                    <Button x:Name="BtnMin" Style="{DynamicResource CaptionButton}" Click="BtnMin_Click" ToolTip="最小化">
                        <Path Width="12" Height="12" Stretch="None" VerticalAlignment="Center"
                              Data="M2,6 L10,6" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{DynamicResource CaptionButton}" Click="BtnMax_Click" ToolTip="最大化">
                        <Rectangle Width="10" Height="10" VerticalAlignment="Center"
                                   Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.4" Fill="Transparent"
                                   RadiusX="1.5" RadiusY="1.5" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{DynamicResource CloseCaptionButton}" Click="BtnClose_Click" ToolTip="关闭">
                        <Path Width="12" Height="12" Stretch="None" VerticalAlignment="Center"
                              Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" Stroke="{DynamicResource SubTextBrush}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1" Margin="14,6,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 表头行：模型分段选择（右列从内容行开始，保证两张卡片上边框对齐） -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,10">
                    <RadioButton x:Name="SegPreset" GroupName="model" IsChecked="True"
                                 Style="{DynamicResource SegRadio}" Checked="Seg_Checked" Tag="Preset">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A3,3 0 0,0 7,16A3,3 0 0,0 10,19A3,3 0 0,0 13,16V7H18V5H12V3Z" />
                            <TextBlock Text="预置音色" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SegClone" GroupName="model"
                                 Style="{DynamicResource SegRadio}" Checked="Seg_Checked" Tag="Clone">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M19,21H8A2,2 0 0,1 6,19V7A2,2 0 0,1 8,5H19A2,2 0 0,1 21,7V19A2,2 0 0,1 19,21M19,3H8A4,4 0 0,0 4,7V21A4,4 0 0,0 8,25H19A4,4 0 0,0 23,21V7A4,4 0 0,0 19,3M16,1H4A3,3 0 0,0 1,4V16H3V4A1,1 0 0,1 4,3H16V1Z" />
                            <TextBlock Text="音色克隆" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SegDesign" GroupName="model"
                                 Style="{DynamicResource SegRadio}" Checked="Seg_Checked" Tag="Design">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M7.5,5.6L10,7L8.6,4.5L10,2L7.5,3.4L5,2L6.4,4.5L5,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L19.5,3.4L17,2L18.4,4.5L17,7L19.5,5.6L22,7L20.6,4.5L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L5.04,22.71C4.65,23.1 4,23.1 3.63,22.71L1.29,20.37C0.9,20 0.9,19.35 1.29,18.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z" />
                            <TextBlock Text="音色设计" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="ModelIdText" Text="mimo-v2.5-tts" Margin="14,0,0,0"
                               VerticalAlignment="Center" Style="{DynamicResource Hint}" />
                </StackPanel>

                <!-- ===== 左列：模型配置 + 文本 + 操作 ===== -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 面板：预置音色 -->
                    <Border x:Name="PanelPreset" Grid.Row="0" Style="{DynamicResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="预置音色" Style="{DynamicResource Label}" Margin="0,0,0,8" />
                            <ComboBox x:Name="CmbVoice" Style="{DynamicResource ModernComboBox}" Height="34"
                                      SelectionChanged="CmbVoice_SelectionChanged" />
                            <TextBlock Style="{DynamicResource Hint}" Margin="1,8,0,0"
                                       Text="冰糖/茉莉/苏打/白桦 = 中文；Mia/Chloe/Milo/Dean = 英文；mimo_default 为集群默认。" />
                        </StackPanel>
                    </Border>

                    <!-- 面板：音色克隆 -->
                    <Border x:Name="PanelClone" Grid.Row="0" Style="{DynamicResource Card}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="参考音频（mp3 / wav，Base64 ≤ 10MB，数秒即可）" Style="{DynamicResource Label}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRefPath" Grid.Column="0" MinHeight="34" IsReadOnly="True"
                                         Style="{DynamicResource ModernTextBox}" Padding="9,0"
                                         Text="" Foreground="{DynamicResource SubTextBrush}" />
                                <Button x:Name="BtnPickRef" Grid.Column="2" Style="{DynamicResource GhostButton}"
                                        Height="34" Padding="14,0" Click="BtnPickRef_Click" Content="浏览…" />
                            </Grid>
                            <TextBlock x:Name="RefInfoText" Style="{DynamicResource Hint}" Margin="1,8,0,0"
                                       Text="未选择文件。提示：选吐字清晰、语速平稳、10~30 秒的段落克隆效果最好。" />
                        </StackPanel>
                    </Border>

                    <!-- 面板：音色设计（维度调整） -->
                    <Border x:Name="PanelDesign" Grid.Row="0" Style="{DynamicResource Card}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="音色维度（每维选预设或「其它」自填）" Style="{DynamicResource Label}" Margin="0,0,0,8" />
                            <StackPanel x:Name="DimsHost" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="补充描述" Style="{DynamicResource Label}"
                                           VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />
                                <TextBox x:Name="TxtDesignExtra" Grid.Column="1" Style="{DynamicResource ModernTextBox}"
                                         MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         Text="" />
                            </Grid>
                            <TextBlock x:Name="DesignPreview" Style="{DynamicResource Hint}" Margin="1,8,0,0"
                                       TextWrapping="Wrap" Text="合成时将按所选维度自动拼装音色描述。" />
                        </StackPanel>
                    </Border>

                    <!-- 合成文本 -->
                    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="合成文本（assistant 消息）" Style="{DynamicResource Label}" />
                                <TextBlock HorizontalAlignment="Right" Style="{DynamicResource Hint}"
                                           Text="可开头加 (风格) 标签、文中插 [音频标签]，如 (活泼)…(吸气)…" />
                            </Grid>
                            <TextBox x:Name="TxtText" Style="{DynamicResource ModernTextBox}" MinHeight="88"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="9,6"
                                     Text="大家好，这里是 MiMo 语音合成工作台。春天来了，风变得温暖，我们一起去跑步吧！" />
                        </StackPanel>
                    </Border>

                    <!-- 风格指令 -->
                    <Border x:Name="CardStyle" Grid.Row="2" Style="{DynamicResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="风格指令（user 消息，可选）" Style="{DynamicResource Label}" />
                            </Grid>
                            <TextBox x:Name="TxtStyle" Style="{DynamicResource ModernTextBox}" MinHeight="54"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="9,6"
                                     Text="" />
                        </StackPanel>
                    </Border>

                    <!-- 操作行 -->
                    <Grid Grid.Row="3" VerticalAlignment="Top" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnGen" Style="{DynamicResource PrimaryButton}" Height="38" Padding="26,0"
                                    Click="BtnGen_Click" Content="生成音频" />
                            <CheckBox x:Name="ChkAutoPlay" Content="自动播放" Style="{DynamicResource ModernCheckBox}"
                                      Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                      ToolTip="生成完成后自动播放；记录内仍可单独播放/拖动进度"
                                      Checked="ChkAutoPlay_Changed" Unchecked="ChkAutoPlay_Changed" />
                            <Button x:Name="BtnOpenDir" Style="{DynamicResource GhostButton}" Height="38" Padding="18,0"
                                    Margin="16,0,0,0" Click="BtnOpenDir_Click" Content="打开目录" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>

                <!-- ===== 右列：历史 + 日志 ===== -->
                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="4,0,4,8">
                                <TextBlock Text="生成记录" Style="{DynamicResource Label}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="HistoryHint" Style="{DynamicResource Hint}" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <Button x:Name="BtnRefreshHistory" Style="{DynamicResource IconMiniButton}"
                                            Click="BtnRefreshHistory_Click" ToolTip="重新扫描输出目录">
                                        <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                              Fill="{DynamicResource SubTextBrush}"
                                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="LstHistory" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="LstHistory_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,7" CornerRadius="6">
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{DynamicResource ModernContextMenu}">
                                                    <MenuItem Header="重命名…" Style="{DynamicResource ModernMenuItem}"
                                                              Click="MenuRename_Click" />
                                                    <Separator />
                                                    <MenuItem Header="删除…" Style="{DynamicResource ModernMenuItem}"
                                                              Click="MenuDelete_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Style="{DynamicResource IconMiniButton}" Margin="4,0,0,0"
                                                                Tag="{Binding}" Click="RowRename_Click" ToolTip="重命名">
                                                            <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                                                  Fill="{DynamicResource SubTextBrush}"
                                                                  Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center"
                                                                   FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                                        <Button Style="{DynamicResource IconMiniButton}" Margin="4,0,0,0"
                                                                Tag="{Binding}" Click="RowDelete_Click" ToolTip="删除">
                                                            <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"
                                                                  Fill="{DynamicResource SubTextBrush}"
                                                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding TextSnippet}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding TextSnippet, Converter={StaticResource EmptyToCollapsed}}" />
                                                <TextBlock Text="{Binding FileName}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource InfoBrush}" TextTrimming="CharacterEllipsis" />

                                                <!-- 内嵌迷你播放器 -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{DynamicResource IconMiniButton}"
                                                            Tag="{Binding}" Click="RowPlay_Click" ToolTip="播放 / 暂停">
                                                        <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                                              Fill="{DynamicResource AccentBrush}" Data="{Binding PlayGlyph}" />
                                                    </Button>
                                                    <Slider Grid.Column="1" Style="{DynamicResource MiniSlider}" Margin="7,0"
                                                            Minimum="0" Maximum="{Binding Duration}"
                                                            Value="{Binding Position, Mode=OneWay}"
                                                            ValueChanged="RowSeek_ValueChanged"
                                                            Thumb.DragCompleted="RowSeek_DragCompleted" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="10.5"
                                                               VerticalAlignment="Center" MinWidth="62" TextAlignment="Right"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="日志" Style="{DynamicResource Label}" Margin="4,0,0,8" />
                            <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                     Background="{DynamicResource LogBgBrush}" BorderThickness="0" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 设置浮层 ===== -->
                <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed">
                    <Rectangle Fill="#88000000" MouseLeftButtonDown="SettingsOverlay_Backdrop_Click" />
                    <Border Style="{DynamicResource Card}" Width="560" Padding="24,20"
                            Background="{DynamicResource CardStrongBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="设置" Style="{DynamicResource H1}" Margin="0,0,0,14" />

                            <TextBlock Text="MiMo API Key（默认隐藏，点「显示」查看）" Style="{DynamicResource Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <PasswordBox x:Name="PwdApiKey" Style="{DynamicResource ModernPasswordBox}" />
                                    <TextBox x:Name="TxtApiKey" Style="{DynamicResource ModernTextBox}" MinHeight="34"
                                             VerticalContentAlignment="Center" Padding="9,0" FontFamily="Consolas"
                                             Visibility="Collapsed" />
                                </Grid>
                                <CheckBox x:Name="ChkShowKey" Grid.Column="2" Content="显示"
                                          Style="{DynamicResource ModernCheckBox}"
                                          Checked="ChkShowKey_Changed" Unchecked="ChkShowKey_Changed" />
                            </Grid>
                            <TextBlock Style="{DynamicResource Hint}" Margin="1,6,0,0" TextWrapping="Wrap">
                                <Run Text="需在 MiMo 开放平台注册后创建，仅存本机 settings.ini。" /><LineBreak />
                                <Hyperlink Foreground="{DynamicResource AccentBrush}" TextDecorations="None"
                                           NavigateUri="https://platform.xiaomimimo.com/console/api-keys"
                                           RequestNavigate="Link_RequestNavigate">打开控制台获取 API Key →</Hyperlink>
                            </TextBlock>

                            <TextBlock Text="输出目录" Style="{DynamicResource Label}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOutDir" Grid.Column="0" MinHeight="34" VerticalContentAlignment="Center"
                                         Padding="9,0" Style="{DynamicResource ModernTextBox}" />
                                <Button x:Name="BtnPickOutDir" Grid.Column="2" Style="{DynamicResource GhostButton}"
                                        MinHeight="34" Padding="14,0" Click="BtnPickOutDir_Click" Content="浏览…" />
                            </Grid>

                            <TextBlock Text="输出格式" Style="{DynamicResource Label}" Margin="0,14,0,6" />
                            <ComboBox x:Name="CmbFormat" Style="{DynamicResource ModernComboBox}" MinHeight="34" />
                            <TextBlock Style="{DynamicResource Hint}" Margin="1,6,0,0" TextWrapping="Wrap"
                                       Text="API 支持 wav / mp3 / pcm / pcm16；pcm 与 pcm16 为无文件头裸流（24kHz 单声道 16bit）。" />

                            <Grid Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnSettingsCancel" Style="{DynamicResource GhostButton}" Height="36"
                                            Padding="20,0" Click="BtnSettingsCancel_Click" Content="取消" />
                                    <Button x:Name="BtnSettingsSave" Style="{DynamicResource PrimaryButton}" Height="36"
                                            Padding="20,0" Margin="10,0,0,0" Click="BtnSettingsSave_Click" Content="保存" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 关于 / 版权申明 ===== -->
                <Grid x:Name="AboutOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                      Visibility="Collapsed">
                    <Rectangle Fill="#88000000" MouseLeftButtonDown="AboutOverlay_Backdrop_Click" />
                    <Border Style="{DynamicResource Card}" Width="560" Padding="26,22"
                            Background="{DynamicResource CardStrongBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/logo.png" Width="52" Height="52" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="MiMo TTS Voice Craft" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock x:Name="AboutVersion" Style="{DynamicResource Hint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{DynamicResource SeparatorLine}" Margin="0,16,0,14" />

                            <TextBlock Style="{DynamicResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="· 本工具是第三方非官方客户端，与小米公司及 MiMo 官方无任何隶属、合作或背书关系。" />
                            <TextBlock Style="{DynamicResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="· 仅支持接入 MiMo-V2.5-TTS 系列三个模型：mimo-v2.5-tts、mimo-v2.5-tts-voiceclone、mimo-v2.5-tts-voicedesign。" />
                            <TextBlock Style="{DynamicResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="· 模型、接口及相关服务的版权与解释权归小米公司所有；API Key 需自行在官方平台申请，用量与费用由使用者自行承担。" />
                            <TextBlock Style="{DynamicResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="· 音色克隆功能请确保对参考音频拥有合法授权，不得用于侵权、冒充他人或任何违法用途。" />
                            <TextBlock Style="{DynamicResource Label}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="· 本工具按 MIT 许可协议开源，版权归 BillChen 所有，按「原样」提供，不承担任何担保责任。" />

                            <TextBlock Style="{DynamicResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap">
                                <Hyperlink Foreground="{DynamicResource AccentBrush}" TextDecorations="None"
                                           NavigateUri="https://github.com/cjx2022/mimo-tts-voice-craft"
                                           RequestNavigate="Link_RequestNavigate">github.com/cjx2022/mimo-tts-voice-craft</Hyperlink>
                            </TextBlock>

                            <Grid Margin="0,18,0,0">
                                <Button Style="{DynamicResource PrimaryButton}" Height="34" Padding="20,0"
                                        HorizontalAlignment="Right" Click="BtnAboutClose_Click" Content="知道了" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 删除确认浮层 ===== -->
                <Grid x:Name="DeleteOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                      Visibility="Collapsed">
                    <Rectangle Fill="#77000000" MouseLeftButtonDown="DeleteOverlay_Backdrop_Click" />
                    <Border Style="{DynamicResource Card}" Width="470" Padding="22,18"
                            Background="{DynamicResource CardStrongBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="删除记录" Style="{DynamicResource H1}" Margin="0,0,0,12" />
                            <TextBlock x:Name="DeleteInfo" Style="{DynamicResource Label}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="「仅移除记录」只从列表里去掉，音频文件保留；「删除记录和文件」会把音频移入回收站（可从回收站恢复）。" />
                            <Grid Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource GhostButton}" Height="34" Padding="16,0"
                                            Click="BtnDeleteCancel_Click" Content="取消" />
                                    <Button Style="{DynamicResource GhostButton}" Height="34" Padding="16,0" Margin="10,0,0,0"
                                            Click="BtnDeleteRecordOnly_Click" Content="仅移除记录" />
                                    <Button Style="{DynamicResource DangerButton}" Height="34" Padding="16,0" Margin="10,0,0,0"
                                            Click="BtnDeleteRecordAndFile_Click" Content="删除记录和文件" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 重命名浮层 ===== -->
                <Grid x:Name="RenameOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                      Visibility="Collapsed">
                    <Rectangle Fill="#77000000" />
                    <Border Style="{DynamicResource Card}" Width="420" Padding="22,18"
                            Background="{DynamicResource CardStrongBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="重命名记录" Style="{DynamicResource H1}" Margin="0,0,0,12" />
                            <TextBox x:Name="TxtRename" Style="{DynamicResource ModernTextBox}" MinHeight="34"
                                     VerticalContentAlignment="Center" Padding="9,0" />
                            <TextBlock Style="{DynamicResource Hint}" Margin="1,6,0,0"
                                       Text="留空则恢复为生成时的模型/音色标签。" />
                            <Grid Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource GhostButton}" Height="34" Padding="18,0"
                                            Click="BtnRenameCancel_Click" Content="取消" />
                                    <Button Style="{DynamicResource PrimaryButton}" Height="34" Padding="18,0"
                                            Margin="10,0,0,0" Click="BtnRenameSave_Click" Content="保存" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Grid Grid.Row="2" Margin="16,0,16,0">
                <TextBlock x:Name="StatusLeft" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource SubTextBrush}" Text="就绪" />
                <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource MutedBrush}" Text="" />
            </Grid>
        </Grid>
    </Border>
</Window>
